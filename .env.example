# =============================================================================
# 群钓鱼插件 · 环境变量模板
#
# 用法：
#   cp .env.example .env      然后照着填
#   docker compose up -d --build
#
# ⚠️ .env 里全是密钥，**绝对不要提交到 Git**（.gitignore 已经排除 .env）。
#    AstrBot 本身不读 .env，是容器的 entrypoint 在启动时把它写进
#    data/cmd_config.json（已存在的值不会被覆盖，除非设
#    FISHING_CONFIG_OVERWRITE=1）。
# =============================================================================

# ---------- 基础 ----------
# IANA 时区，中国填 Asia/Shanghai
TZ=Asia/Shanghai
# 管理面板端口（宿主机侧）
DASHBOARD_PORT=6185
# 首次初始化时的面板密码；留空 = AstrBot 自动生成随机密码并打印在日志里
# 查看日志：docker compose logs -f astrbot
ASTRBOT_DASHBOARD_INITIAL_PASSWORD=

# ---------- QQ 官方机器人（QQ 开放平台）----------
# 机器人管理端 -> 开发设置 里的 AppID / AppSecret
QQ_ENABLE=false
QQ_APPID=
QQ_SECRET=
# 是否允许群聊里 @机器人 使用
QQ_ENABLE_GROUP_C2C=true
# 是否允许频道私信
QQ_ENABLE_GUILD_DM=true
# 是否用 markdown 发消息（按钮功能依赖官方键盘接口，建议保持 true）
QQ_USE_MARKDOWN=true

# ---------- OneBot v11（NapCat / Lagrange / LLOneBot 等）----------
# 走反向 WebSocket：在 NapCat 里把上报地址填成
#   ws://<本机IP>:6199/ws
ONEBOT_ENABLE=false
# 宿主机映射端口（与 AstrBot 容器内的 ws_reverse_port 一致）
ONEBOT_WS_PORT=6199
# 反向 WS 的 access token，建议随便设一串随机字符
ONEBOT_WS_TOKEN=

# ---------- 高级 ----------
# 设成 1：.env 里的值强行覆盖 cmd_config.json 里已有的值（默认只在为空时写入）
FISHING_CONFIG_OVERWRITE=0
# 设成 1：每次启动都用镜像里的插件覆盖数据卷里的插件目录
FISHING_FORCE_SYNC=0
